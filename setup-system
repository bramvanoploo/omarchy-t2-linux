#!/bin/bash
set -euo pipefail
umask 077

[[ $EUID -eq 0 ]] || { echo "Run with sudo: sudo ./setup-system" >&2; exit 1; }
src=$(cd -- "$(dirname -- "$0")" && pwd)

[[ -f "$src/scripts/omapple-helper" ]] || { echo "Missing $src/scripts/omapple-helper" >&2; exit 1; }
[[ -f "$src/scripts/omapple-plugins-helper.py" ]] || { echo "Missing $src/scripts/omapple-plugins-helper.py" >&2; exit 1; }
[[ -f "$src/system/90-omapple.rules" ]] || { echo "Missing $src/system/90-omapple.rules" >&2; exit 1; }

bash -n "$src/scripts/omapple-helper"
python3 -I -m py_compile "$src/scripts/omapple-plugins-helper.py"

install -Dm755 "$src/scripts/omapple-helper" /usr/local/libexec/omapple-helper
rm -f /usr/local/libexec/omarchy-t2-helper
ln -sf /usr/local/libexec/omapple-helper /usr/local/libexec/omarchy-t2-helper

install -Dm755 "$src/scripts/omapple-plugins-helper.py" /usr/local/libexec/omapple-plugins-helper.py
rm -f /usr/local/libexec/t2-plugins-helper.py
ln -sf /usr/local/libexec/omapple-plugins-helper.py /usr/local/libexec/t2-plugins-helper.py

install -Dm644 "$src/system/90-omapple.rules" /etc/polkit-1/rules.d/90-omapple.rules
rm -f /etc/polkit-1/rules.d/90-omarchy-t2-linux.rules
install -Dm644 "$src/system/90-omapple.rules" /etc/polkit-1/rules.d/90-omarchy-t2-linux.rules

systemctl daemon-reload >/dev/null 2>&1 || true
systemctl try-restart polkitd.service >/dev/null 2>&1 || true

echo "✓ Installed /usr/local/libexec/omapple-helper, omapple-plugins-helper.py and polkit rules (with backwards compatibility symlinks)."
